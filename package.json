{
	"name": "boba-tech",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "next dev",
		"dev:next": "next dev",
		"build": "next build && opennextjs-cloudflare build --skipBuild",
		"start": "next start",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"fix": "pnpm run lint:fix && pnpm run format",
		"deploy": "opennextjs-cloudflare",
		"cf:build": "opennextjs-cloudflare build",
		"cf:deploy": "opennextjs-cloudflare deploy",
		"cf:preview": "opennextjs-cloudflare preview",
		"cf-typegen": "wrangler types --env-interface CloudflareEnv ./cloudflare-env.d.ts",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:push": "drizzle-kit push",
		"db:studio": "drizzle-kit studio",
		"test": "vitest run",
		"test:watch": "vitest watch",
		"test:coverage": "vitest run --coverage",
		"generate:og": "tsx scripts/generate-og-image.ts",
		"generate:og:help": "tsx scripts/generate-og-help.ts",
		"generate:og:default": "tsx scripts/generate-og-default.ts",
		"generate:og:nala": "tsx scripts/generate-og-nala.ts"
	},
	"dependencies": {
		"@next/third-parties": "^16.4.6",
		"@opennextjs/cloudflare": "^1.20.17",
		"@portabletext/react": "^8.0.1",
		"@portabletext/types": "^4.0.2",
		"@react-email/components": "^1.0.12",
		"@react-email/render": "^2.3.1",
		"@sanity/client": "^8.17.0",
		"@sanity/image-url": "^2.1.1",
		"@t3-oss/env-nextjs": "^0.13.11",
		"@tanstack/react-table": "^9.3.1",
		"better-auth": "^1.7.25",
		"clsx": "^2.1.1",
		"drizzle-kit": "^0.31.11",
		"drizzle-orm": "^0.45.4",
		"embla-carousel-react": "^8.6.0",
		"framer-motion": "^14.14.0",
		"lucide-react": "^1.73.0",
		"next": "16.4.6",
		"next-intl": "^4.15.1",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"react-email": "^6.11.13",
		"react-syntax-highlighter": "^16.1.1",
		"resend": "^6.38.1",
		"simple-icons": "^16.38.0",
		"tailwind-merge": "^3.6.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20261115.1",
		"@eslint/eslintrc": "^3.3.6",
		"@eslint/js": "^10.0.1",
		"@fontsource/sora": "^5.3.0",
		"@tailwindcss/postcss": "^4.3.5",
		"@types/node": "^26.6.6",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@types/react-syntax-highlighter": "^15.5.13",
		"@vitest/coverage-v8": "^4.1.10",
		"eslint": "^10.15.0",
		"eslint-config-next": "16.4.6",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.6",
		"globals": "^17.14.0",
		"prettier": "^3.10.1",
		"satori": "^0.63.2",
		"sharp": "^0.35.3",
		"tailwindcss": "^4.3.5",
		"tsx": "^4.23.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.2",
		"vitest": "^4.1.10",
		"wrangler": "^4.158.0"
	}
}
